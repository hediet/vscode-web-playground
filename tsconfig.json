{
	"compilerOptions": {
		"target": "ES2022",
		"module": "preserve",
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"experimentalDecorators": true,
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"types": ["vite/client"]
	},
	"include": ["src", "vite.config.ts"]
